<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="autoen_alokairua.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:autoen_alokairua"
    Shell.FlyoutBehavior="Disabled"
    Title="Autoen Alokairua">

    <TabBar>
        <ShellContent
            Title="Ibilgailuak"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Bezeroak"
            ContentTemplate="{DataTemplate local:Bezeroak}"
            Route="Bezeroak" />

        <ShellContent
            Title="Alokairuak"
            ContentTemplate="{DataTemplate local:Alokairuak}"
            Route="Alokairuak" />
    </TabBar>
</Shell>