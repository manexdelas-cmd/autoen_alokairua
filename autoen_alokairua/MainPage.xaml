<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="autoen_alokairua.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <!-- Egitura nagusia: Bi zutabetan banatuta (ezkerreko zerrenda eta eskuineko fitxa) -->
    <Grid ColumnDefinitions="380, *" ColumnSpacing="24" Padding="24">

        <!-- EZKERREKO PANELA (Bilatzailea, Iragazkia eta Zerrenda) -->
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, Auto, *" RowSpacing="12">

            <!-- Ibilgailu berria gehitzeko leiho modala irekitzen duen botoia -->
            <Button Grid.Row="0" Text="+ Gehitu Ibilgailua" BackgroundColor="#1E5280" TextColor="White" CornerRadius="10" FontAttributes="Bold" Clicked="OnGehituAutoaClicked" HeightRequest="48">
                <Button.Shadow>
                    <Shadow Brush="#1E5280" Offset="0,4" Radius="10" Opacity="0.25" />
                </Button.Shadow>
            </Button>

            <!-- Ibilgailuak matrikularen, markaren edo modeloaren arabera iragazteko bilatzailea -->
            <Border Grid.Row="1" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" HeightRequest="48">
                <SearchBar x:Name="searchautoa" Placeholder="Bilatu matrikula, marka edo modeloa..." TextChanged="OnBuscarAutoaChanged" VerticalOptions="Center" Margin="4,0" />
            </Border>

            <!-- Eskuragarri dauden ibilgailuak bakarrik iragazteko botoia -->
            <Button Grid.Row="2" 
                    x:Name="btnFiltroEskuragarri" 
                    Text="Iragazi: Guztiak erakutsi" 
                    BackgroundColor="#E2E8F0" 
                    TextColor="#334155" 
                    CornerRadius="10" 
                    FontAttributes="Bold" 
                    HeightRequest="40" 
                    Clicked="OnFiltroEskuragarriClicked" />

            <!-- Datu-basetik kargatutako ibilgailuen zerrenda interaktiboa -->
            <CollectionView Grid.Row="3" x:Name="listaautoas" SelectionMode="Single" SelectionChanged="OnAutoaSeleccionado">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" Padding="16" StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow Brush="#94A3B8" Offset="0,2" Radius="6" Opacity="0.1" />
                            </Border.Shadow>

                            <!-- Txartelaren ikusizko egoerak (Normala, Sagua gainean, Hautatuta) -->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="White" />
                                            <Setter Property="Stroke" Value="#E2E8F0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                            <Setter Property="Stroke" Value="#CBD5E1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#F0F9FF" />
                                            <Setter Property="Stroke" Value="#38BDF8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Txartel bakoitzaren barruko edukia (Marka/Modeloa, Matrikula eta Prezioa) -->
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="16" TextColor="#0F172A">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Marka" />
                                                <Binding Path="Modeloa" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Matrikula, StringFormat='Matrikula: {0}'}" FontSize="13" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding EgunekoPrezioa, StringFormat='{0:F2} €/Egun'}" FontSize="15" FontAttributes="Bold" TextColor="#15803D" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ESKUINEKO PANELA (Xehetasunak eta Edizioa) -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Spacing="24">
                <Border Stroke="Transparent" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="32">
                    <Border.Shadow>
                        <Shadow Brush="#94A3B8" Offset="0,8" Radius="24" Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="24">
                        <!-- Hautatutako ibilgailuaren izenburu nagusia -->
                        <Label x:Name="lblTituloautoa" Text="Aukeratu ibilgailu bat" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" Margin="0,0,0,8" />

                        <!-- Datuen sareta (Irakurketa eta edizio eremuekin txandakatzeko prestatuta) -->
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="16" ColumnSpacing="16">

                            <!-- MATRIKULA -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="MATRIKULA" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                    <Label x:Name="lblMatricula" Text="---" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Entry x:Name="entryMatricula" IsVisible="False" TextColor="#0F172A" BackgroundColor="White" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- MARKA -->
                            <Border Grid.Row="1" Grid.Column="0" Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="MARKA" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                    <Label x:Name="lblMarka" Text="---" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Entry x:Name="entryMarka" IsVisible="False" TextColor="#0F172A" BackgroundColor="White" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- MODELOA -->
                            <Border Grid.Row="1" Grid.Column="1" Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="MODELOA" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                    <Label x:Name="lblModeloa" Text="---" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Entry x:Name="entryModeloa" IsVisible="False" TextColor="#0F172A" BackgroundColor="White" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- URTEA -->
                            <Border Grid.Row="2" Grid.Column="0" Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="URTEA" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                    <Label x:Name="lblUrtea" Text="---" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Entry x:Name="entryUrtea" IsVisible="False" Keyboard="Numeric" TextColor="#0F172A" BackgroundColor="White" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- ERREGAIA -->
                            <Border Grid.Row="2" Grid.Column="1" Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="ERREGAIA" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                    <Label x:Name="lblErregaia" Text="---" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Entry x:Name="entryErregaia" IsVisible="False" TextColor="#0F172A" BackgroundColor="White" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- EGUNEKO PREZIOA -->
                            <Border Grid.Row="3" Grid.Column="0" Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="PREZIOA (€ / EGUN)" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                    <Label x:Name="lblPrecio" Text="---" FontSize="18" FontAttributes="Bold" TextColor="#15803D" />
                                    <Entry x:Name="entryPrecio" IsVisible="False" Keyboard="Numeric" TextColor="#0F172A" BackgroundColor="White" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- ESKURAGARRITASUN EGOERA -->
                            <Border Grid.Row="3" Grid.Column="1" Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="ESKURAGARRI?" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                                    <Switch x:Name="switchEskuragarri" IsEnabled="False" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,16" />

                        <!-- Ekintza botoiak: Hautatutako ibilgailua editatzeko edo ezabatzeko -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                            <Button x:Name="btnEditatu" Grid.Column="0" Text="Editatu" BackgroundColor="#F59E0B" TextColor="White" CornerRadius="10" HeightRequest="48" FontAttributes="Bold" Clicked="OnEditatuAutoaClicked" />
                            <Button x:Name="btnEzabatu" Grid.Column="1" Text="Ezabatu" BackgroundColor="#EF4444" TextColor="White" CornerRadius="10" HeightRequest="48" FontAttributes="Bold" Clicked="OnEzabatuAutoaClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- IBILGAILU BERRIA GEHITZEKO LEIHO MODALA -->
        <Grid x:Name="vistaGehitu" Grid.ColumnSpan="2" BackgroundColor="#B3000000" IsVisible="False" InputTransparent="False">
            <Border WidthRequest="460" BackgroundColor="White" Padding="32" VerticalOptions="Center" HorizontalOptions="Center" StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="30" Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Ibilgailu Berria" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" Margin="0,0,0,8"/>

                    <!-- Ibilgailu berriaren datuak sartzeko formularioa -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                            <Label Text="MATRIKULA" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                            <Entry x:Name="entryBerriMatricula" Placeholder="Adib: 1234 ABC" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="MARKA" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                            <Entry x:Name="entryBerriMarka" Placeholder="Adib: Toyota" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="MODELOA" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                            <Entry x:Name="entryBerriModeloa" Placeholder="Adib: Yaris" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                            <Label Text="URTEA" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                            <Entry x:Name="entryBerriUrtea" Keyboard="Numeric" Placeholder="Adib: 2022" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                            <Label Text="ERREGAIA" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                            <Picker x:Name="pickerBerriErregaia" Title="Aukeratu..." TextColor="#0F172A" BackgroundColor="#F8FAFC">
                                <Picker.Items>
                                    <x:String>Diesel</x:String>
                                    <x:String>Gasolina</x:String>
                                    <x:String>Elektrikoa</x:String>
                                    <x:String>Hibridoa</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="EGUNEKO PREZIOA (€)" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Entry x:Name="entryBerriPrecio" Keyboard="Numeric" Placeholder="Adib: 45.50" TextColor="#0F172A" BackgroundColor="#F8FAFC"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,8"/>

                    <!-- Modalaren kontrol botoiak (Utzi edo Gorde) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Button Grid.Column="0" Text="Utzi" BackgroundColor="#94A3B8" TextColor="White" Clicked="OnUtziGehituClicked" CornerRadius="10" HeightRequest="45" FontAttributes="Bold"/>
                        <Button Grid.Column="1" Text="Gorde" BackgroundColor="#1E5280" TextColor="White" Clicked="OnGordeBerriaClicked" CornerRadius="10" HeightRequest="45" FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>